# Local: leave empty so Vite proxies /api to http://localhost:8000
# Vercel: set this in Project Settings → Environment Variables
# Example: https://your-api.onrender.com
VITE_API_URL=

# Public site origin for Open Graph, Twitter, and canonical URLs (no trailing slash)
# Vercel: set this in Project Settings → Environment Variables, then redeploy
VITE_SITE_URL=https://eco-mind-myanmar.vercel.app
