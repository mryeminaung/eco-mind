# PORT: Listen port. Default 8000. PaaS hosts (Render, Railway, Fly) set this.
PORT=8000

# MONGODB_URI: Optional. Local Mongo or Atlas. Leave unset to use the in-memory store.
# Atlas example (no real credentials here):
# MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ecomind?retryWrites=true&w=majority"
MONGODB_URI="mongodb://localhost:27017/ecomind"
MONGODB_USERNAME=
MONGODB_PASSWORD=

# OPENROUTER_API_KEY: OpenRouter key for the AI waste scanner (preferred).
# OPENROUTER_MODEL: Optional vision model. Default is google/gemini-2.5-flash.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="google/gemini-2.5-flash"

# GEMINI_API_KEY: Optional direct Gemini fallback if OpenRouter is unset.
GEMINI_API_KEY=

# JWT_SECRET: Secret used to sign authentication tokens. Change this in production.
JWT_SECRET="ecomind-myanmar-mvp-secret"

# APP_URL: Frontend origin. Used in OpenRouter referer headers.
APP_URL="http://localhost:3000"
