# MONGODB_URI: Optional connection string for MongoDB database.
# If not provided, the Express backend automatically uses an in-memory/embedded data store fallback.
MONGODB_URI="mongodb://localhost:27017/recycleconnect"

# GEMINI_API_KEY: Google Gemini API Key for server-side AI Vision Waste Scanner
GEMINI_API_KEY=

# JWT_SECRET: Secret used to sign authentication tokens. Change this in production.
JWT_SECRET="recycleconnect-myanmar-mvp-secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

